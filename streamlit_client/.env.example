# URL of the running privacy middleware API.
PRIVACY_API_BASE_URL=http://127.0.0.1:8000

# The following values configure the middleware's outbound LLM connection.
# Keep MODEL_API_KEY secret. Start the middleware from this folder using
# run_middleware.py so it reads this .env file.
# LiteLLM supports Ollama, OpenAI, Anthropic, Gemini, Azure, and many more.
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
MODEL_NAME=ollama/llama3.2
MODEL_TIMEOUT_SECONDS=60
SESSION_TTL_SECONDS=900
LOG_LEVEL=INFO
LOG_FILE=logs/middleware.log
